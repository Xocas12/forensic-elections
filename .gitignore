# ---- raw / interim / processed data never enter git (rule 5) ----
projects/*/data/raw/*
projects/*/data/interim/*
projects/*/data/processed/*
!projects/*/data/raw/.gitkeep
!projects/*/data/interim/.gitkeep
!projects/*/data/processed/.gitkeep
# fetch logs are regenerated by `make data`; the SOURCES.yaml registry IS committed
projects/*/data/fetch_log.jsonl
projects/*/data/.cache/

# ---- python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.hypothesis/
.coverage
htmlcov/
build/
dist/

# ---- notebooks: outputs stripped by nbstripout; checkpoints ignored ----
.ipynb_checkpoints/

# ---- local secrets / contact config overrides ----
config/forensics.local.toml
.env

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
